rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOperator() {
      return request.auth != null
        && (exists(/databases/$(database)/documents/operators/$(request.auth.uid))
          || (request.auth.token.email_verified == true
            && get(/databases/$(database)/documents/operatorEmails/$(request.auth.token.email)).data.enabled == true));
    }
    function isManager() {
      return request.auth != null
        && get(/databases/$(database)/documents/operators/$(request.auth.uid)).data.manager == true;
    }
    function validResult() {
      let data = request.resource.data;
      return data.keys().hasOnly(['votes', 'revision', 'updatedAt'])
        && data.votes is map
        && data.votes.size() >= 3
        && data.votes.blank is int && data.votes.blank >= 0 && data.votes.blank <= 1000000
        && data.votes['null'] is int && data.votes['null'] >= 0 && data.votes['null'] <= 1000000
        && data.revision is int && data.updatedAt == request.time;
    }
    match /operators/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
    match /operatorEmails/{email} {
      allow get: if request.auth != null && request.auth.token.email == email;
      allow read: if isManager();
      allow create, update: if isManager()
        && request.resource.data.keys().hasOnly(['enabled'])
        && request.resource.data.enabled is bool;
    }
    match /pollingPlaces/{alias} {
      allow read: if isOperator();
      allow create: if isManager()
        && alias.size() <= 24
        && alias.matches('^[A-Z0-9]+(-[A-Z0-9]+)*$')
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;
      match /stations/{code} {
        allow read: if isOperator();
        allow create, update: if isManager()
          && exists(/databases/$(database)/documents/pollingPlaces/$(alias))
          && code.matches('^([0-9]{3}|[1-9][0-9]{3,4})-[HM]$')
          && request.resource.data.keys().hasOnly(['registered'])
          && request.resource.data.registered == true;
      }
    }
    match /elections/{electionId}/results/{resultId} {
      allow read: if true;
      allow create: if isOperator() && validResult() && request.resource.data.revision == 1;
      allow update: if isOperator() && validResult()
        && request.resource.data.votes.keys().hasAll(resource.data.votes.keys())
        && request.resource.data.votes.keys().hasOnly(resource.data.votes.keys())
        && request.resource.data.revision == resource.data.revision + 1;
    }
  }
}
